# Copy this file to .env.local and fill in your real key.
# Required: your OpenAI API key. The app and evals will not run without it.
OPENAI_API_KEY=sk-...

# Optional overrides (sensible defaults are in lib/config.ts).
# Per-run token budget before the agent is forced to finish.
# TOKEN_BUDGET=60000
# Hard wall-clock cap for a single agent run, in milliseconds.
# RUN_TIMEOUT_MS=180000
